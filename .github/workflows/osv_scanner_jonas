name: OSV-Scanner

on:
  pull_request:
    branches: [ "master" ]
  merge_group:
    branches: [ "master" ]
  schedule:
    - cron: '23 8 * * 3'
  push:
    branches: [ "master" ]

permissions:
  security-events: write
  contents: read

jobs:
  scan-scheduled:
    if: ${{ github.event_name == 'push' || github.event_name == 'schedule' }}
    uses: "google/osv-scanner-action/.github/workflows/osv-scanner-reusable.yml@1f1242919d8a60496dd1874b24b62b2370ed4c78"
    with:
      scan-args: |-
        -r
        --skip-git
        ./
    steps:
      - name: List scanned files
        run: |
          mkdir -p artifacts
          find . -type f \( \
            -name "*.c" -o -name "*.cpp" -o -name "*.h" -o -name "*.hpp" \
            -o -name "vcpkg.json" -o -name "conanfile.txt" -o -name "conanfile.py" \
          \) > artifacts/scanned_files.txt

      - name: Upload scanned files artifact
        uses: actions/upload-artifact@v3
        with:
          name: scanned-files
          path: artifacts/scanned_files.txt

  scan-pr:
    if: ${{ github.event_name == 'pull_request' || github.event_name == 'merge_group' }}
    uses: "google/osv-scanner-action/.github/workflows/osv-scanner-reusable-pr.yml@1f1242919d8a60496dd1874b24b62b2370ed4c78"
    with:
      scan-args: |-
        -r
        --skip-git
        ./
    steps:
      - name: List scanned files
        run: |
          mkdir -p artifacts
          find . -type f \( \
            -name "*.c" -o -name "*.cpp" -o -name "*.h" -o -name "*.hpp" \
            -o -name "vcpkg.json" -o -name "conanfile.txt" -o -name "conanfile.py" \
          \) > artifacts/scanned_files.txt

      - name: Upload scanned files artifact
        uses: actions/upload-artifact@v3
        with:
          name: scanned-files
          path: artifacts/scanned_files.txt
