version: 2
updates:
  # Maven / Gradle dependencies in root and subfolders
  - package-ecosystem: maven
    directory: "/"  # root folder
    schedule:
      interval: weekly
    open-pull-requests-limit: 10
    target-branch: master
    # Optional grouping for critical libraries
    groups:
      opencv:
        patterns:
          - "org.opencv:*"
      bouncycastle:
        patterns:
          - "org.bouncycastle:*"
      guava:
        patterns:
          - "com.google.guava:*"
      junit:
        patterns:
          - "org.junit.jupiter:*"
          - "org.junit.platform:*"
      mockito:
        patterns:
          - "org.mockito:*"

  # Scan all subdirectories for additional Maven/Gradle projects
  - package-ecosystem: maven
    directory: "/submodules"  # example subfolder; replicate for other subfolders
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    target-branch: master

  # npm packages (UI or JS tooling)
  - package-ecosystem: npm
    directory: "/ui"
    schedule:
      interval: weekly
    open-pull-requests-limit: 2
    target-branch: master
    groups:
      opencv-ui:
        patterns:
          - "*"

  # GitHub Actions workflows
  - package-ecosystem: "github-actions"
    directory: "/.github/workflows"
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    target-branch: master

  # Optional: monitor Git submodules (if repo includes any)
  - package-ecosystem: "submodules"
    directory: "/"
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    target-branch: master
